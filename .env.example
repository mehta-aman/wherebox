# WhereBox Environment Configuration Template
# Copy this file to .env.local for local development. Never commit real secrets.

# ==========================================
# 1. Supabase (Database & Authentication)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key_here

# ==========================================
# 2. Tracking Provider API (Milestone 3)
# ==========================================
# Provider choices: 17TRACK, Ship24, or AfterShip
TRACKING_PROVIDER_NAME=17track
TRACKING_PROVIDER_API_KEY=your_tracking_provider_api_key_here
TRACKING_WEBHOOK_SECRET=your_webhook_signature_secret_here

# ==========================================
# 3. Google OAuth & Gmail Discovery (Milestone 5)
# ==========================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ==========================================
# 4. Application URL
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
